// #region UDT's

type PivotSnapshot
    float price = na
    int bar = na
    int timeUnix = na
    bool isHigh = false

type ZigzagPoint
    float price = na
    int bar = na
    int timeUnix = na
    bool isHigh = false
    bool inSession = false
    MS.DIR dirAtCreation = na
    float extHighPrice = na
    float extLowPrice = na
type LegData
    bool isBullish = false
    float startPrice = na
    float endPrice = na
    int startBar = na
    int endBar = na
    int startTime = na
    int endTime = na
    float priceDistance = na
    float atrMultiple = na
    bool isWithTrend = false
    bool isCounterTrend = false
    bool brokeStructure = false
    bool startInSession = false
    bool endInSession = false
    MS.DIR dirAtStart = na

type LegCategoryStats
    int count = 0
    int atrCount = 0
    float totalPrice = 0.0
    float totalAtr = 0.0
    float minPrice = na
    float maxPrice = na
    float minAtr = na
    float maxAtr = na

type RevisitData
    bool pivotIsHigh = false
    float pivotPrice = na
    int pivotTime = na
    int pivotBar = na
    float breakPrice = na
    int breakTime = na
    int breakBar = na
    bool breakInSession = false
    int ageMs = na
    bool firstNextIsHigh = false
    bool hasNextHigh = false
    float nextHighPrice = na
    int nextHighTime = na
    float nextHighPriceDist = na
    int nextHighTimeDist = na
    bool hasNextLow = false
    float nextLowPrice = na
    int nextLowTime = na
    float nextLowPriceDist = na
    int nextLowTimeDist = na
    float atrAtCompletion = na

type RevisitCategoryStats
    int count = 0
    float totalAgeMs = 0.0
    float maxAgeMs = na
    int nextHighCount = 0
    int atrValidCount = 0
    float totalPH = 0.0
    float minPH = na
    float maxPH = na
    float totalAtrH = 0.0
    float totalTH = 0.0
    float minTH = na
    float maxTH = na
    float totalPL = 0.0
    float minPL = na
    float maxPL = na
    float totalAtrL = 0.0
    float totalTL = 0.0
    float minTL = na
    float maxTL = na

// #endregion UDT's
