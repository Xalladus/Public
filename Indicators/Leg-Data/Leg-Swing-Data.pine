//@version=6
indicator("Market Structure Analysis", "MSAnalysis", overlay=true, max_bars_back=5000, max_labels_count=500)

import OneCleverGuy/InputLibrary/4 as iLib
import OneCleverGuy/MarketStructureLibrary/30 as MS
import OneCleverGuy/ATRxSession/4 as ATRxS

//+-------------------------------------------------------+
//                       INFORMATION                      |
//+-------------------------------------------------------+
// #region Information

// Market Structure Analysis — two modes via the Analysis Type input.
//
// ── LEG ANALYSIS ──────────────────────────────────────────────────────────
// Measures swing-to-swing legs (low→high = bullish, high→low = bearish).
// Consecutive same-direction swings collapse to the most extreme point.
// Broken down by Side → Session → Trend / Structure / combinations.
//
// ── REVISIT ANALYSIS ──────────────────────────────────────────────────────
// Tracks what happens when a confirmed swing level is touched/broken. Records
// the age at break, what structure formed next, and price / time distance to
// the next confirmed high and low after the break.
//
// ── REVISIT DETECTION LOGIC ───────────────────────────────────────────────
// Every confirmed pivot is stored in an active registry. On each bar the
// current high/low is tested against every active level; the moment price
// reaches a level (high >= a stored high, or low <= a stored low) it is marked
// broken and removed. A record then waits for the next confirmed swing high
// AND low that form after the break before it is counted. Untouched pivots
// stay pending forever and are not counted; the title shows the pending total.
//
// ── SIGNED DISTANCES ──────────────────────────────────────────────────────
// Distances to the next swings are measured in the break's direction: a high
// break points up, a low break points down. Swings with the break direction
// are positive; swings against it are negative. So for a high break a next low
// beneath the level is negative, and for a low break a next high above it is.
//
// ── TERMS ─────────────────────────────────────────────────────────────────
//   With Trend      Leg matches outer structure direction.
//   Counter Trend   Leg opposes outer structure direction.
//   Broke Structure Leg endpoint exceeded the external level present at start.
//   No Break        Leg stayed inside prevailing structure (internal).
//   Session ATR     ATR computed only from bars inside the session.
// Direction persists through Ranging / Unknown periods until the opposite
// direction is confirmed, so every leg after the first trend has a direction.

// #endregion Information
//+-------------------------------------------------------+
//                          INPUTS                        |
//+-------------------------------------------------------+
// #region Inputs

// #region Input Enums ************************************

enum AnalysisType
    legAnalysis     = "Leg Analysis"
    revisitAnalysis = "Revisit Analysis"

enum LegDisplaySides
    both        = "Bullish + Bearish"
    bullishOnly = "Bullish Only"
    bearishOnly = "Bearish Only"

enum OutsideStartRule
    countsOut = "Out of Session"
    countsIn  = "In Session"

enum TablePosition
    topRight     = "Top Right"
    topCenter    = "Top Center"
    topLeft      = "Top Left"
    middleRight  = "Middle Right"
    middleCenter = "Middle Center"
    middleLeft   = "Middle Left"
    bottomRight  = "Bottom Right"
    bottomCenter = "Bottom Center"
    bottomLeft   = "Bottom Left"

// #endregion Input Enums

// #region Tooltips ***************************************

string tt_analysis    = "Select which analysis to display in the table and log to CSV."
string tt_legSides    = "Choose whether the leg table shows bullish rows, bearish rows, or both."
string tt_timezone    = "Timezone for session boundaries, log timestamps, and display."
string tt_session     = "Trading session window for ATR and session classification."
string tt_outsideRule = "When a leg starts outside the session but finishes inside, choose"
  + " whether it counts as In or Out. Starts inside are always In; fully outside are Out."
  + " Applies to Leg Analysis only."
string tt_atrCount    = "Completed sessions averaged for session ATR and smoothing length."
string tt_lookbacks   = "Pivot detection lookback / lookahead."
string tt_useATR      = "Require an ATR-scaled pullback before confirming new pivots."
string tt_atrMult     = "Pullback must exceed this multiple of session ATR to confirm."
string tt_tablePos    = "Position of the analysis table on the chart."
string tt_textSize    = "Text size for table content."
string tt_csvLog      = "Emit CSV rows per confirmed record to Pine Logs."
string tt_debug       = "Draw diagnostic labels on confirmed legs or completed revisits."

// #endregion Tooltips

// #region Analysis ***************************************

var string iGrpA = "Analysis"
i_analysisType = input.enum(AnalysisType.legAnalysis, "Analysis Type", group=iGrpA, tooltip=tt_analysis)
i_legSides = input.enum(LegDisplaySides.both, "Leg Rows", group=iGrpA, tooltip=tt_legSides,
  active=(i_analysisType == AnalysisType.legAnalysis))

// #endregion Analysis

// #region Session & Timezone *****************************

