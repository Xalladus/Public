string REV_CSV = "Rev#,PivotType,PivotPrice,PivotTime,BreakTime,AgeMs,BreakInSess,"
  + "FirstNextHigh,NHPrice,NHTime,SignedPriceTH,TimeTH,NLPrice,NLTime,SignedPriceTL,TimeTL"
string REV_CSV_LEGEND = "Legend: Rev#=completed revisit sequence, PivotType=broken pivot side High or Low, PivotPrice=broken pivot price, "
  + "PivotTime=broken pivot confirmation time, BreakTime=first touch/break time, AgeMs=milliseconds from pivot confirmation to break, "
  + "BreakInSess=whether the break happened inside the session, FirstNextHigh=whether the first post-break confirmed swing was a high, "
  + "NHPrice=next confirmed high price after break, NHTime=next confirmed high time, SignedPriceTH=signed price distance from break to next high, "
  + "TimeTH=milliseconds from break to next high, NLPrice=next confirmed low price after break, NLTime=next confirmed low time, "
  + "SignedPriceTL=signed price distance from break to next low, TimeTL=milliseconds from break to next low."
var MS.Pivot[] pivots                 = array.new<MS.Pivot>()
var MS.State msState                  = MS.State.new()
var MS.DIR msDir                      = MS.DIR.Unknown
var MS.DIR persistentDir              = MS.DIR.Unknown
var array<ZigzagPoint> zigzag         = array.new<ZigzagPoint>()
var array<LegData> legs               = array.new<LegData>()
var array<PivotSnapshot> activePivots = array.new<PivotSnapshot>()
var array<RevisitData> pendingRevs    = array.new<RevisitData>()
var array<RevisitData> confirmedRevs  = array.new<RevisitData>()
