string tblPos = switch i_tablePos
    TablePosition.topRight     => position.top_right
    TablePosition.topCenter    => position.top_center
    TablePosition.topLeft      => position.top_left
    TablePosition.middleRight  => position.middle_right
    TablePosition.middleCenter => position.middle_center
    TablePosition.middleLeft   => position.middle_left
    TablePosition.bottomRight  => position.bottom_right
    TablePosition.bottomCenter => position.bottom_center
    TablePosition.bottomLeft   => position.bottom_left
var table tbl = table.new(tblPos, TBL_COLS, TBL_ROWS,
