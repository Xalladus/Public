int TBL_COLS = (IS_LEG_MODE ? LEG_COLS : REV_COLS)
string LEG_CSV = "Leg#,StartTime,StartPrice,EndTime,EndPrice,Direction,Distance,"
  + "ATRMult,TrendDir,TrendRel,BrokeStructure,StartInSess,EndInSess,Session"
string LEG_CSV_LEGEND = "Legend: Leg#=confirmed leg sequence, StartTime=leg start pivot time, StartPrice=leg start pivot price, "
  + "EndTime=leg end pivot time, EndPrice=leg end pivot price, Direction=Bull or Bear, Distance=absolute price move from start to end, "
  + "ATRMult=Distance divided by session ATR, TrendDir=outer structure direction at leg start, TrendRel=With/Counter/None vs TrendDir, "
  + "BrokeStructure=true if the leg exceeded the external level present at start, StartInSess=start pivot inside session, "
