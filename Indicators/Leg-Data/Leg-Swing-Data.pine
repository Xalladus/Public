i_session     = input.session("0930-1600", "Session",            group=iGrpS, tooltip=tt_session)
i_outsideRule = input.enum(OutsideStartRule.countsOut, "Starting Outside →", group=iGrpS, tooltip=tt_outsideRule,
  active=(i_analysisType == AnalysisType.legAnalysis))

// #endregion Session & Timezone

// #region ATR Settings ***********************************

var string iGrpATR = "ATR Settings"
i_atrCount = input.int(14, "Session ATR Count", minval=1, maxval=100, group=iGrpATR, tooltip=tt_atrCount)

// #endregion ATR Settings

// #region Market Structure *******************************

var string iGrpMS = "Market Structure"
i_lookBack    = input.int(3, "Lookback / Lookahead", minval=1, maxval=50, inline="LB", group=iGrpMS, tooltip=tt_lookbacks)
i_lookAhead   = input.int(3, "",                     minval=1, maxval=50, inline="LB", group=iGrpMS)
i_useATR      = input.bool(true, "Use ATR Confirm",                                    group=iGrpMS, tooltip=tt_useATR)
i_atrMultiple = input.float(0.5, "ATR Multiple", minval=0.1, step=0.1,                group=iGrpMS, tooltip=tt_atrMult, active=i_useATR)

