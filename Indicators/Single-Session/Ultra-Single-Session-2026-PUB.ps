//+-------------------------------------------------------+
//                       INFORMATION                      |
//+-------------------------------------------------------+
// #region Information

// Single Session plots one configurable session with a box, high/low lines, labels,
// break alerts, and a trade window that can gate those alerts.
//
// Presets resolve in their native timezone. Custom sessions, the trade window, and line end
// times use the timezone selected by the user. When the first bar after a long weekend or
// holiday gap arrives, the utility library adjusts affected session and line lifecycle times
// from the gap actually present in the chart data.
//
// Daily presets (24-hour sessions) draw nothing for the developing day. The completed previous
// day receives its box and high/low lines; older days follow the history toggles.
//
// Session lifecycle state is owned by UtilityLibrary1CG. This script owns inputs, visuals,
// retention policy, and alert policy.

// #endregion Information

indicator("Single Session", shorttitle = "SingleSess", precision = 5,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, overlay = true)

import OneCleverGuy/UtilityLibrary1CG/1 as UTIL

//+-------------------------------------------------------+
//                          INPUTS                        |
//+-------------------------------------------------------+
// #region Inputs

// #region Input Enums ************************************

enum AlertMode
    off      = "No Alerts"
    onBreak  = "On Break"
    closeOut = "Close Out"
    closeIn  = "Close In (Sweep)"

// #endregion Input Enums

// #region Tooltips ***************************************

string tt_timezone     = "Applied to custom sessions, the trade window, and line end times."
string tt_custom       = "Custom times are in your selected timezone. Presets use their own market timezone."
                       + "\nIdentical open and close times create a 24-hour session."
string tt_colors       = "Major Color: session text, lines, and box outline.\nMinor Color: box fill and background."
string tt_box          = "Style of the session box. Daily presets draw the previous day only."
string tt_boxText      = "Display the session label inside the box."
string tt_highLow      = "Style of the high and low lines. Daily presets draw the previous day only."
string tt_keepAhead    = "The number of bars the line stays in front of price, stopping at line end time."
string tt_nextDay      = "Time the line ends, in your selected timezone. Check the box to extend it another day."
string tt_history      = "Display previous sessions as styled above."
string tt_historyDays  = "Previous occurrences retained, in addition to the current occurrence."
                       + " Gaps do not consume this count. Available chart data can reduce it."
string tt_vLines       = "Vertical lines marking the start and finish of the trade window, in your selected timezone."
string tt_windowBg     = "Shades the chart background while the trade window is open."
string tt_alertSession = "Alerts fire after the session closes, when its high or low is taken."
                       + " With a trade window enabled, only breaks inside that window alert."
                       + "\nOn Break: first touch of the level."
                       + "\nClose Out: candle closes beyond the level."
                       + "\nClose In (Sweep): candle pierces the level and closes back inside."

// #endregion Tooltips

