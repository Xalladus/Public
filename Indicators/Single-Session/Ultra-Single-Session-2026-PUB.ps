//+-------------------------------------------------------+
//                           UDT'S                        |
//+-------------------------------------------------------+
// #region UDT's

// #region Helper UDTs ************************************

type BarTracker
    int sessBar = na
    int hiBar   = na
    int loBar   = na
    int hiTime  = na
    int loTime  = na
    int endBar  = na

type BreakTracker
    int  sessStartTime = na
    bool highBroken    = false
    bool lowBroken     = false
    bool highAlerted   = false
    bool lowAlerted    = false

// Styling is stored as resolved Pine constants so the render path never converts enums per bar.
type SessionVisualConfig
    bool   isEnabled       = false
    color  primeColor      = na
    color  backgroundColor = na
    bool   showBackground  = false
    bool   showHiLo        = false
    string lineStyle       = line.style_dotted
    int    lineWidth       = 1
    bool   showLabel       = false
    bool   showBox         = false
    string boxStyle        = line.style_dashed
    int    boxWidth        = 1
    int    aheadBars       = 10
    bool   showLineHistory = false
    bool   showBoxHistory  = false
    bool   showBoxText     = false
    color  boxTextColor    = #FFFFFF
    string boxTextSize     = size.tiny
    string boxTextHAlign   = text.align_left
    string boxTextVAlign   = text.align_top
    UTIL.SessionAnchor anchor = UTIL.SessionAnchor.SessionEnd

type SessionVisualState
    line  highLine  = na
    label highLabel = na
    line  lowLine   = na
    label lowLabel  = na
    box   square    = na

type TradeWindowState
    int  lastDrawnStart = na
    bool endAdjusted    = false

// #endregion Helper UDTs

// #endregion UDT's

//+-------------------------------------------------------+
//                     GLOBAL VARIABLES                   |
//+-------------------------------------------------------+
// #region Global Variables

// #region Helper Globals *********************************

// #region Runtime Context //

const string SESSION_SLOT_KEY = "sess01"

var string USER_TIMEZONE = i_timeZone.toTimezone()

// Bar replay still reports realtime bars while the replay cursor sits in the past, so the wall
// clock would classify a developing replayed session as already finished. One bar of slack keeps
// a genuinely live bar on the wall clock and sends every replayed bar back to its own bar clock.
int  replayClockSlackMs   = math.max(nz(UTIL.barDurationMs()), UTIL.durationMs(UTIL.Duration.Minute))
bool isReplayLikeRealtime = barstate.isrealtime and not na(time_close) and timenow > time_close + replayClockSlackMs
int  TIMENOW              = (barstate.isrealtime and not isReplayLikeRealtime ? timenow : nz(time_close, time))

bool isTradeWindowActive = i_showWindow and UTIL.isInSession(i_window, USER_TIMEZONE)
// A disabled trade window means every bar qualifies for alerts.
bool isAlertWindowOpen   = not i_showWindow or isTradeWindowActive

int  daysLimit       = (i_showHistory ? i_daysInput : 0)
bool isWithinHistory = UTIL.isWithinHistoryWindow(daysLimit, last_bar_time)

// #endregion Runtime Context

// #region Session State Store //

var array<UTIL.SessionState> sessionStates = array.new<UTIL.SessionState>()

// #endregion Session State Store

// #region Trade Window State //

var array<line> windowStartLines = array.new<line>()
var array<line> windowEndLines   = array.new<line>()
var TradeWindowState windowState = TradeWindowState.new()

// #endregion Trade Window State

// #region Session Config Holders //

var UTIL.SessionConfig sessionConfig = UTIL.SessionConfig.new(
     isEnabled = i_showSession,                 preset = i_sessionPreset,
     customLabel = i_customLabel,               customSession = i_customSession,
     timezone = USER_TIMEZONE,                  anchor = i_lineAnchor,
     lineEndHour = i_lineEndHour.toHourInt(),   lineEndMinute = i_lineEndMinute.toMinuteInt(),
     lineEndTimezone = USER_TIMEZONE,           addExtraLineDay = i_lineExtraDay)

var SessionVisualConfig visualConfig = SessionVisualConfig.new(
     isEnabled       = i_showSession,                     primeColor     = i_primeColor,
     backgroundColor = i_subColor,                        showBackground = i_sessionBg,
     showHiLo        = i_showHiLo,                        lineStyle      = i_hiLoStyle.toLineStyle(),
     lineWidth       = i_hiLoSize.toLineWidth(),          showLabel      = i_showLabel,
     showBox         = i_showBox,                         boxStyle       = i_boxStyle.toLineStyle(),
     boxWidth        = i_boxSize.toLineWidth(),           aheadBars      = i_aheadTime,
     showLineHistory = i_showHistory and i_showLineHistory,
     showBoxHistory  = i_showHistory and i_showBoxHistory,
     showBoxText     = i_showBoxText,                     boxTextColor   = i_boxTextColor,
     boxTextSize     = i_boxTextSize.toTextSizeString(),  boxTextHAlign  = i_boxTextHAlign.toHorizontalAlign(),
     boxTextVAlign   = i_boxTextVAlign.toVerticalAlign(), anchor         = i_lineAnchor)

// #endregion Session Config Holders

// #region Tracking Maps //

var map<string, BarTracker>         barTrackerMap   = map.new<string, BarTracker>()
var map<string, SessionVisualState> visualStateMap = map.new<string, SessionVisualState>()
var map<string, BreakTracker>       breakTrackerMap = map.new<string, BreakTracker>()

// #endregion Tracking Maps

// #endregion Helper Globals

// #endregion Global Variables

//+-------------------------------------------------------+
//                        FUNCTIONS                       |
//+-------------------------------------------------------+
// #region Functions

// #region Shared Helper Functions ************************

sessionInstanceKey(string _slotKey, int _sessStartTime) =>
    _slotKey + ":" + str.tostring(_sessStartTime)

getOrCreateVisualState(string _instanceKey) =>
    if not map.contains(visualStateMap, _instanceKey)
        map.put(visualStateMap, _instanceKey, SessionVisualState.new())
    map.get(visualStateMap, _instanceKey)

renderSessionEnd(UTIL.SessionState _state) =>
    _state.sessEndTime - 1

// #endregion Shared Helper Functions

// #region Trade Window Functions *************************

// @function drawTradeWindow                        - Draws or repositions the vertical lines for the trade window.
// @param    _startLines   (array<line>)            - Window start line pool, newest first.
// @param    _endLines     (array<line>)            - Window end line pool, newest first.
// @param    _windowState  (TradeWindowState)       - Persistent draw state for this window.
// @param    _session      (string)                 - Window session string in the user's timezone.
// @param    _showHistory  (bool)                   - True keeps one line pair per day.
// @param    _lineColor    (color)                  - Line color.
// @param    _lineStyle    (string)                 - Resolved line style constant.
// @param    _lineWidth    (int)                    - Line width in pixels.
// @param    _daysLimit    (int)                    - Days of history allowed.
// @param    _timeNow      (int)                    - Current timestamp.
// @returns                (TradeWindowState)       - Updated draw state.
drawTradeWindow(array<line> _startLines, array<line> _endLines, TradeWindowState _windowState,
     string _session, bool _showHistory, color _lineColor, string _lineStyle, int _lineWidth,
     int _daysLimit, int _timeNow) =>
    UTIL.TradeWindowPlan plan = UTIL.planTradeWindow(_session, USER_TIMEZONE, _daysLimit, _timeNow, _windowState.lastDrawnStart)
    if plan.shouldDraw
        int startLineTime = plan.startTime
        if array.size(_startLines) == 0 or _showHistory
            array.unshift(_startLines, line.new(startLineTime, open, startLineTime, close,
                 xloc.bar_time, extend.both, _lineColor, _lineStyle, _lineWidth))
            array.unshift(_endLines, line.new(plan.endTime, open, plan.endTime, close,
                 xloc.bar_time, extend.both, _lineColor, _lineStyle, _lineWidth))
            UTIL.trimPool(_daysLimit + 1, lines = _startLines)
            UTIL.trimPool(_daysLimit + 1, lines = _endLines)
        if not _showHistory and array.size(_startLines) == 1
            array.get(_startLines, 0).updateLine(_x1 = startLineTime, _x2 = startLineTime)
            array.get(_endLines, 0).updateLine(_x1 = plan.endTime, _x2 = plan.endTime)
        _windowState.lastDrawnStart := plan.startTime
        _windowState.endAdjusted    := false
    // Pin the end line to the bar that actually closed the window when no bar printed at the planned end.
    if not _windowState.endAdjusted and not plan.isInWindow and plan.alreadyDrawn and array.size(_endLines) > 0
        line endLine     = array.get(_endLines, 0)
        int  currentEndX = line.get_x1(endLine)
        if currentEndX > nz(time_close[1], 0) and currentEndX < time
            endLine.updateLine(_x1 = time, _x2 = time)
        _windowState.endAdjusted := true
    _windowState

// @function clearTradeWindow                       - Deletes both line pools for the trade window.
// @param    _startLines   (array<line>)            - Window start line pool.
// @param    _endLines     (array<line>)            - Window end line pool.
// @returns                (TradeWindowState)       - Reset draw state.
clearTradeWindow(array<line> _startLines, array<line> _endLines) =>
    UTIL.clearDrawings(lines = _startLines)
    UTIL.clearDrawings(lines = _endLines)
    TradeWindowState.new()

// #endregion Trade Window Functions

// #region Session Visual Functions ***********************

// #region Session Visual Helpers //

createHiLoLine(bool _isHigh, color _lineColor, string _lineStyle, int _lineWidth) =>
    float anchorPrice = (_isHigh ? high : low)
    line.new(time, anchorPrice, time + UTIL.barDurationMs(), anchorPrice,
         xloc.bar_time, extend.none, _lineColor, _lineStyle, _lineWidth)

createHiLoLabel(bool _isHigh, string _labelText, color _textColor, bool _isBoxShown) =>
    color  transparent = color.new(#000000, 100)
    float  anchorPrice = (_isHigh ? high : low)
    string labelStyle  = (_isBoxShown
        ? (_isHigh ? label.style_label_lower_left : label.style_label_upper_left)
        : label.style_label_left
        )
    label.new(time + UTIL.barDurationMs(), anchorPrice, _labelText,
         xloc = xloc.bar_time, color = transparent, textcolor = _textColor,
         yloc = yloc.price, style = labelStyle)

createSessionBox(int _rightTime, SessionVisualConfig _config, string _boxText) =>
    box created = box.new(time, high, _rightTime, low,
         _config.primeColor, _config.boxWidth, _config.boxStyle,
         extend.none, xloc.bar_time, _config.backgroundColor)
    created.updateBox(
         _text       = (_config.showBoxText ? _boxText : ""),
         _textSize   = _config.boxTextSize,
         _textHAlign = _config.boxTextHAlign,
         _textVAlign = _config.boxTextVAlign,
         _textColor  = (_config.showBoxText ? _config.boxTextColor : _config.primeColor))
    created

clearVisualState(SessionVisualState _visualState, bool _clearLines, bool _clearLabels, bool _clearBoxes) =>
    if _clearLines
        line.delete(_visualState.highLine)
        line.delete(_visualState.lowLine)
        _visualState.highLine := na
        _visualState.lowLine  := na
    if _clearLabels
        label.delete(_visualState.highLabel)
        label.delete(_visualState.lowLabel)
        _visualState.highLabel := na
        _visualState.lowLabel  := na
    if _clearBoxes
        box.delete(_visualState.square)
        _visualState.square := na

applyLabelOffsetStyle(SessionVisualState _visualState, bool _isOffset) =>
    if not na(_visualState.highLabel)
        string highStyle = (_isOffset ? label.style_label_lower_left : label.style_label_left)
        string lowStyle  = (_isOffset ? label.style_label_upper_left : label.style_label_left)
        _visualState.highLabel.updateLabel(_style = highStyle)
        _visualState.lowLabel.updateLabel(_style = lowStyle)

// Session boxes span the chart bars that contain the boundaries, falling back to the scheduled
// boundary when the bar timestamp has not been observed yet.
syncSessionBox(UTIL.SessionState _state, SessionVisualState _visualState, SessionVisualConfig _config) =>
    int boxRight = renderSessionEnd(_state)
    if na(_visualState.square)
        _visualState.square := createSessionBox(boxRight, _config, _state.labelText)
    int leftTime  = (na(_state.sessStartBarTime) ? _state.sessStartTime : _state.sessStartBarTime)
    int rightTime = (na(_state.sessEndBarTime) ? boxRight : _state.sessEndBarTime)
    _visualState.square.updateBox(
         _left        = leftTime,           _top         = _state.highPrice,
         _right       = rightTime,          _bottom      = _state.lowPrice,
         _borderColor = _config.primeColor, _borderWidth = _config.boxWidth,
         _borderStyle = _config.boxStyle,   _bgColor     = _config.backgroundColor)

advanceHiLoLines(UTIL.SessionState _state, SessionVisualState _visualState, SessionVisualConfig _config,
     bool _isDaily, int _timeNow, string _instanceKey) =>
    int  renderEnd          = renderSessionEnd(_state)
    bool isSingleBarSession = (
        not na(_state.sessStartBarTime) and not na(_state.sessEndBarTime)
    ) and _state.sessStartBarTime == _state.sessEndBarTime
    if not na(_visualState.highLine) and not na(_visualState.lowLine) and map.contains(barTrackerMap, _instanceKey)
        BarTracker tracker = map.get(barTrackerMap, _instanceKey)
        if time >= _state.lineEndTime and na(tracker.endBar)
            tracker.endBar := bar_index
        // Keep every coordinate in UNIX time. Converting timestamp anchors to bar indexes can
        // collapse a line when a session boundary falls inside a chart candle.
        int projectedRightTime = time + UTIL.barDurationMs() * _config.aheadBars
        int rightTime = (not na(tracker.endBar)
             ? _state.lineEndTime
             : math.min(projectedRightTime, _state.lineEndTime))
        int lineStartHigh = _state.highLineStartTime
        int lineStartLow  = _state.lowLineStartTime
        if _config.anchor == UTIL.SessionAnchor.SessionEnd and _timeNow > renderEnd
            int endAnchor = nz(_state.sessEndBarTime, renderEnd)
            lineStartHigh := endAnchor
            lineStartLow  := endAnchor
        line.set_xloc(
             _visualState.highLine, lineStartHigh, rightTime, xloc.bar_time)
        line.set_xloc(
             _visualState.lowLine, lineStartLow, rightTime, xloc.bar_time)
        if _config.showLabel and not na(_visualState.highLabel) and not na(_visualState.lowLabel)
            label.set_xloc(_visualState.highLabel, rightTime, xloc.bar_time)
            label.set_xloc(_visualState.lowLabel, rightTime, xloc.bar_time)
    if _timeNow <= renderEnd and _config.showBox and not _isDaily
        applyLabelOffsetStyle(_visualState, not isSingleBarSession)
    if _timeNow > renderEnd and not _isDaily
        applyLabelOffsetStyle(_visualState, false)

ensureCurrentSessionShapes(UTIL.SessionState _state, SessionVisualConfig _config, bool _isDaily,
     string _instanceKey) =>
    // The developing daily session draws nothing; its shapes appear once the day completes.
    if not _isDaily
        SessionVisualState visualState = getOrCreateVisualState(_instanceKey)
        if _config.showHiLo
            if na(visualState.highLine)
                visualState.highLine := createHiLoLine(true, _config.primeColor, _config.lineStyle, _config.lineWidth)
            if na(visualState.lowLine)
                visualState.lowLine := createHiLoLine(false, _config.primeColor, _config.lineStyle, _config.lineWidth)
            visualState.highLine.updateLine(_y1 = _state.highPrice, _y2 = _state.highPrice)
            visualState.lowLine.updateLine(_y1 = _state.lowPrice, _y2 = _state.lowPrice)
            if _config.showLabel
                if na(visualState.highLabel)
                    visualState.highLabel := createHiLoLabel(true, _state.labelText + " High", _config.primeColor, _config.showBox)
                if na(visualState.lowLabel)
                    visualState.lowLabel := createHiLoLabel(false, _state.labelText + " Low", _config.primeColor, _config.showBox)
                visualState.highLabel.updateLabel(_y = _state.highPrice, _text = _state.labelText + " High")
                visualState.lowLabel.updateLabel(_y = _state.lowPrice, _text = _state.labelText + " Low")
            else
                clearVisualState(visualState, false, true, false)
        else
            clearVisualState(visualState, true, true, false)
        if _config.showBox
            syncSessionBox(_state, visualState, _config)
        else
            clearVisualState(visualState, false, false, true)
        map.put(visualStateMap, _instanceKey, visualState)

applyHistoryVisuals(UTIL.SessionState _state, SessionVisualConfig _config, bool _isDaily,
     string _instanceKey) =>
    SessionVisualState visualState = getOrCreateVisualState(_instanceKey)
    if _isDaily
        // Daily sessions never draw a live session, so the historical pass owns every shape,
        // including the completed day's box.
        if _config.showHiLo
            int lineStartHigh = _state.highLineStartTime
            int lineStartLow  = _state.lowLineStartTime
            if _config.anchor == UTIL.SessionAnchor.SessionEnd
                int endAnchor = nz(_state.sessEndBarTime, renderSessionEnd(_state))
                lineStartHigh := endAnchor
                lineStartLow  := endAnchor
            if na(visualState.highLine)
                visualState.highLine := createHiLoLine(true, _config.primeColor, _config.lineStyle, _config.lineWidth)
            if na(visualState.lowLine)
                visualState.lowLine := createHiLoLine(false, _config.primeColor, _config.lineStyle, _config.lineWidth)
            visualState.highLine.updateLine(
                 _x1 = lineStartHigh,      _y1 = _state.highPrice,
                 _x2 = _state.lineEndTime, _y2 = _state.highPrice)
            visualState.lowLine.updateLine(
                 _x1 = lineStartLow,       _y1 = _state.lowPrice,
                 _x2 = _state.lineEndTime, _y2 = _state.lowPrice)
            if _config.showLabel
                if na(visualState.highLabel)
                    visualState.highLabel := createHiLoLabel(true, "PDH", _config.primeColor, false)
                if na(visualState.lowLabel)
                    visualState.lowLabel := createHiLoLabel(false, "PDL", _config.primeColor, false)
                visualState.highLabel.updateLabel(_x = _state.lineEndTime, _y = _state.highPrice, _text = "PDH", _style = label.style_label_left)
                visualState.lowLabel.updateLabel(_x = _state.lineEndTime, _y = _state.lowPrice, _text = "PDL", _style = label.style_label_left)
            else
                clearVisualState(visualState, false, true, false)
        else
            clearVisualState(visualState, true, true, false)
        if _config.showBox
            syncSessionBox(_state, visualState, _config)
        else
            clearVisualState(visualState, false, false, true)
    else
        if _config.showHiLo and _config.showLineHistory and _config.showLabel
            visualState.highLabel.updateLabel(_text = "H", _style = label.style_label_left)
            visualState.lowLabel.updateLabel(_text = "L", _style = label.style_label_left)
        if not (_config.showHiLo and _config.showLineHistory)
            clearVisualState(visualState, true, true, false)
        if not (_config.showBox and _config.showBoxHistory)
            clearVisualState(visualState, false, false, true)
    map.put(visualStateMap, _instanceKey, visualState)

isNewSessionInstance(array<UTIL.SessionState> _states, bool _isDaily, bool _isFirstBarOfSession,
     string _slotKey) =>
    // A scheduled opening during a resumed weekend session is not a new instance.
    bool isNewSession = _isFirstBarOfSession and array.size(_states) > 0 and (
         array.get(_states, 0).sessStartTime >= time and array.get(_states, 0).sessStartTime < time_close)
    if not isNewSession and not _isDaily and array.size(_states) > 0
        string instanceKey = sessionInstanceKey(_slotKey, array.get(_states, 0).sessStartTime)
        isNewSession := not map.contains(barTrackerMap, instanceKey)
    isNewSession

registerStateTracker(UTIL.SessionState _state, string _slotKey) =>
    string instanceKey = sessionInstanceKey(_slotKey, _state.sessStartTime)
    if not map.contains(barTrackerMap, instanceKey)
        map.put(barTrackerMap, instanceKey, BarTracker.new(
             bar_index, bar_index, bar_index, _state.highLineStartTime, _state.lowLineStartTime))
    // Preserve the engine's original start-bar timestamp when rendering deferred history.
    getOrCreateVisualState(instanceKey)

registerSessionTracker(array<UTIL.SessionState> _states, string _slotKey) =>
    if array.size(_states) > 0
        registerStateTracker(array.get(_states, 0), _slotKey)

pruneExpiredSession(array<UTIL.SessionState> _states, int _daysLimit, bool _isDaily,
     string _slotKey) =>
    // A scheduled record with no prices is not an observed historical session.
    // Keep index 0 because it may be waiting for its first qualifying live data.
    if array.size(_states) > 1
        for index = array.size(_states) - 1 to 1
            UTIL.SessionState candidate = array.get(_states, index)
            if na(candidate.openPrice) and na(candidate.highPrice) and na(candidate.lowPrice) and na(candidate.closePrice)
                string emptyKey = sessionInstanceKey(_slotKey, candidate.sessStartTime)
                if map.contains(visualStateMap, emptyKey)
                    clearVisualState(map.get(visualStateMap, emptyKey), true, true, true)
                    map.remove(visualStateMap, emptyKey)
                map.remove(barTrackerMap, emptyKey)
                array.remove(_states, index)
    int retainLimit = _daysLimit + (_isDaily ? 2 : 1)
    while array.size(_states) > retainLimit
        UTIL.SessionState removed = array.pop(_states)
        string instanceKey        = sessionInstanceKey(_slotKey, removed.sessStartTime)
        if map.contains(visualStateMap, instanceKey)
            clearVisualState(map.get(visualStateMap, instanceKey), true, true, true)
            map.remove(visualStateMap, instanceKey)
        map.remove(barTrackerMap, instanceKey)

trimDailyHistoryVisuals(array<UTIL.SessionState> _states, SessionVisualConfig _config, bool _isDaily,
     string _slotKey) =>
    if _isDaily and array.size(_states) > 2
        for index = 2 to array.size(_states) - 1
            UTIL.SessionState state        = array.get(_states, index)
            string instanceKey             = sessionInstanceKey(_slotKey, state.sessStartTime)
            SessionVisualState visualState = getOrCreateVisualState(instanceKey)
            if not _config.showLineHistory
                clearVisualState(visualState, true, true, false)
            if not _config.showBoxHistory
                clearVisualState(visualState, false, false, true)

renderSessionStates(array<UTIL.SessionState> _states, SessionVisualConfig _config, bool _isDaily,
     int _timeNow, string _slotKey) =>
    for [index, state] in _states
        int  renderEnd           = renderSessionEnd(state)
        bool sessionIsLive       = _timeNow <= renderEnd
        bool sessionEndInsideBar = renderEnd >= time and renderEnd < time_close
        bool sessionEndsThisBar  = time > renderEnd and time[1] <= renderEnd
        bool lineIsLive          = _config.showHiLo and _timeNow <= state.lineEndTime
        bool lineEndsThisBar     = _config.showHiLo and time >= state.lineEndTime and time[1] < state.lineEndTime
        bool needsVisualUpdate   = sessionIsLive or sessionEndInsideBar or sessionEndsThisBar or lineIsLive or lineEndsThisBar
        if needsVisualUpdate
            string instanceKey = sessionInstanceKey(_slotKey, state.sessStartTime)
            // An observed gap can extend an endpoint that was previously frozen.
            if map.contains(barTrackerMap, instanceKey) and time < state.lineEndTime
                BarTracker resumedTracker = map.get(barTrackerMap, instanceKey)
                resumedTracker.endBar := int(na)
            bool isFrozen = (map.contains(barTrackerMap, instanceKey)
                 ? not na(map.get(barTrackerMap, instanceKey).endBar)
                 : false)
            SessionVisualState visualState = getOrCreateVisualState(instanceKey)
            // Intraday sessions own their drawings on the newest record; daily sessions own them on
            // the most recently completed day. Replay stepping, a mid-session reload, or an input
            // change can skip the session-open bar, so rebuild those shapes from stored state
            // whenever they are missing instead of waiting for an edge that already passed.
            bool ownsCurrentDrawings = (_isDaily ? index == 1 : index == 0)
            bool hasExpectedShapes   = (not _config.showHiLo or not na(visualState.highLine)) and
              (not _config.showBox or not na(visualState.square))
            bool needsShapeRebuild   = ownsCurrentDrawings and not hasExpectedShapes
            // Historical objects are already created with the current input styles on each script run.
            // Only the live lifecycle needs per-bar drawing updates.
            if not isFrozen
                if sessionEndInsideBar and na(state.sessEndBarTime)
                    state.sessEndBarTime := time
                if not _isDaily and (sessionIsLive or sessionEndInsideBar or needsShapeRebuild)
                    ensureCurrentSessionShapes(state, _config, false, instanceKey)
                if _isDaily and needsShapeRebuild
                    applyHistoryVisuals(state, _config, true, instanceKey)
                if _config.showHiLo
                    advanceHiLoLines(state, visualState, _config, _isDaily, _timeNow, instanceKey)
                if time > renderEnd and time[1] <= renderEnd
                    applyLabelOffsetStyle(visualState, false)
    true

// Build only the retained drawings after the historical calculations have finished.
// History visibility is applied before creation, avoiding create-then-delete work.
renderRetainedSessionHistory(array<UTIL.SessionState> _states, SessionVisualConfig _config,
     bool _isDaily, int _timeNow, string _slotKey) =>
    for [index, state] in _states
        bool isPrevious = index > 0
        if not _isDaily or isPrevious
            SessionVisualConfig appearance = _config.copy()
            if isPrevious and (not _isDaily or index > 1)
                appearance.showHiLo := _config.showHiLo and _config.showLineHistory
                appearance.showBox := _config.showBox and _config.showBoxHistory
            if appearance.showHiLo or appearance.showBox
                string instanceKey = sessionInstanceKey(_slotKey, state.sessStartTime)
                SessionVisualState visualState = registerStateTracker(state, _slotKey)
                if _isDaily
                    applyHistoryVisuals(state, appearance, true, instanceKey)
                else
                    ensureCurrentSessionShapes(state, appearance, false, instanceKey)
                advanceHiLoLines(state, visualState, appearance, _isDaily, _timeNow, instanceKey)
                if isPrevious and not _isDaily
                    applyHistoryVisuals(state, appearance, false, instanceKey)
    // The current daily record has no drawings, but needs a tracker for live rollover.
    if _isDaily and array.size(_states) > 0
        registerSessionTracker(_states, _slotKey)
    true

// #endregion Session Visual Helpers

// @function syncSessionVisuals                     - Creates, updates, and prunes every drawing for the tracked session.
// @param    _config       (UTIL.SessionConfig)     - Session configuration for this slot.
// @param    _visualConfig (SessionVisualConfig)    - Resolved appearance settings for this slot.
// @param    _sessionInfo  (UTIL.SessionInfo)       - Descriptor returned by the session engine, including its timezone.
// @param    _states       (array<UTIL.SessionState>) - Session state storage for this slot.
// @param    _timeNow      (int)                    - Current timestamp.
// @param    _daysLimit    (int)                    - Days of history allowed.
// @param    _slotKey      (string)                 - Stable session-slot identity used to namespace drawing state.
// @returns                (bool)                   - Whether session visuals are enabled.
syncSessionVisuals(UTIL.SessionConfig _config, SessionVisualConfig _visualConfig, UTIL.SessionInfo _sessionInfo,
     array<UTIL.SessionState> _states, int _timeNow, int _daysLimit, string _slotKey) =>
    if _config.isEnabled
        // Retain lightweight records on every bar; ordinary historical bars create no session drawings.
        pruneExpiredSession(_states, _daysLimit, _sessionInfo.isDaily, _slotKey)
        if barstate.islastconfirmedhistory
            renderRetainedSessionHistory(_states, _visualConfig, _sessionInfo.isDaily, _timeNow, _slotKey)
        else if barstate.isrealtime or barstate.islast
            int boundaryOffset = UTIL.barDayBoundaryOffsetMs(
                 _sessionInfo.timezone, _sessionInfo.openHour, _sessionInfo.openMinute)
            bool isFirstBar = UTIL.isSessionFirstBar(_sessionInfo, boundaryOffset)
            bool isNewSession = isNewSessionInstance(_states, _sessionInfo.isDaily, isFirstBar, _slotKey)
            if isNewSession
                registerSessionTracker(_states, _slotKey)
                if array.size(_states) > 1
                    UTIL.SessionState previous = array.get(_states, 1)
                    applyHistoryVisuals(previous, _visualConfig, _sessionInfo.isDaily,
                         sessionInstanceKey(_slotKey, previous.sessStartTime))
                trimDailyHistoryVisuals(_states, _visualConfig, _sessionInfo.isDaily, _slotKey)
            renderSessionStates(_states, _visualConfig, _sessionInfo.isDaily, _timeNow, _slotKey)
    _config.isEnabled

// #endregion Session Visual Functions

// #region Alert Functions ********************************

// #region Alert Helpers //

registerBreak(BreakTracker _tracker, bool _isHigh, bool _hasBroken, bool _isInWindow, string _message) =>
    bool didAlert = false
    if _isHigh and _hasBroken and not _tracker.highBroken
        _tracker.highBroken := true
        if _isInWindow
            _tracker.highAlerted := true
            alert(_message, alert.freq_once_per_bar)
            didAlert := true
    if not _isHigh and _hasBroken and not _tracker.lowBroken
        _tracker.lowBroken := true
        if _isInWindow
            _tracker.lowAlerted := true
            alert(_message, alert.freq_once_per_bar)
            didAlert := true
    didAlert

findAlertableSession(array<UTIL.SessionState> _states, int _timeNow) =>
    UTIL.SessionState result = na
    for state in _states
        if _timeNow > renderSessionEnd(state) and _timeNow <= state.lineEndTime
            result := state
            break
    result

// #endregion Alert Helpers

// @function processSessionBreakAlerts              - Evaluates break, close-out, and sweep alerts for the session.
// @param    _states       (array<UTIL.SessionState>) - Session state storage for this slot.
// @param    _alertMode    (AlertMode)              - Alert behavior selected by the user.
// @param    _sessionLabel (string)                 - Label used in the alert message.
// @param    _timeNow      (int)                    - Current timestamp.
// @param    _isInWindow   (bool)                   - True when breaks are allowed to alert on this bar.
// @param    _slotKey      (string)                 - Stable session-slot identity used to namespace alert state.
// @returns                ([bool, bool])           - High-break and low-break marker flags for this bar.
processSessionBreakAlerts(array<UTIL.SessionState> _states, AlertMode _alertMode, string _sessionLabel,
     int _timeNow, bool _isInWindow, string _slotKey) =>
    bool showHighMarker = false
    bool showLowMarker  = false
    if _alertMode != AlertMode.off
        UTIL.SessionState state = findAlertableSession(_states, _timeNow)
        if not na(state)
            string trackerKey = sessionInstanceKey(_slotKey, state.sessStartTime)
            if not map.contains(breakTrackerMap, trackerKey)
                map.put(breakTrackerMap, trackerKey, BreakTracker.new(state.sessStartTime))
            BreakTracker tracker = map.get(breakTrackerMap, trackerKey)
            switch _alertMode
                AlertMode.onBreak =>
                    showHighMarker := registerBreak(tracker, true, high > state.highPrice, _isInWindow,
                         "Price breaking " + _sessionLabel + " high.")
                    showLowMarker := registerBreak(tracker, false, low < state.lowPrice, _isInWindow,
                         "Price breaking " + _sessionLabel + " low.")
                AlertMode.closeOut =>
                    if barstate.isconfirmed
                        showHighMarker := registerBreak(tracker, true, close > state.highPrice, _isInWindow,
                             "Price closed above " + _sessionLabel + " high.")
                        showLowMarker := registerBreak(tracker, false, close < state.lowPrice, _isInWindow,
                             "Price closed below " + _sessionLabel + " low.")
                AlertMode.closeIn =>
                    if barstate.isconfirmed
                        bool sweptHigh = high > state.highPrice and close <= state.highPrice
                        bool sweptLow  = low < state.lowPrice and close >= state.lowPrice
                        showHighMarker := registerBreak(tracker, true, sweptHigh, _isInWindow,
                             "Price swept " + _sessionLabel + " high.")
                        showLowMarker := registerBreak(tracker, false, sweptLow, _isInWindow,
                             "Price swept " + _sessionLabel + " low.")
            map.put(breakTrackerMap, trackerKey, tracker)
    [showHighMarker, showLowMarker]

// @function pruneBreakTrackers                     - Removes break trackers whose session is no longer stored.
// @param    _states       (array<UTIL.SessionState>) - Session state storage for this slot.
// @param    _slotKey      (string)                 - Stable session-slot identity used to namespace alert state.
// @returns                (void)
pruneBreakTrackers(array<UTIL.SessionState> _states, string _slotKey) =>
    array<string> liveKeys = array.new<string>()
    for state in _states
        array.push(liveKeys, sessionInstanceKey(_slotKey, state.sessStartTime))
    array<string> staleKeys = array.new<string>()
    for [trackerKey, _tracker] in breakTrackerMap
        if array.indexof(liveKeys, trackerKey) == -1
            array.push(staleKeys, trackerKey)
    for staleKey in staleKeys
        map.remove(breakTrackerMap, staleKey)

// #endregion Alert Functions

// #endregion Functions

//+-------------------------------------------------------+
//                        EXECUTION                       |
//+-------------------------------------------------------+
// #region Execution

// #region Shared Runtime Context *************************

bool needsIntrabarData = false
if sessionConfig.isEnabled and timeframe.isintraday and timeframe.in_seconds() > 60
    UTIL.SessionInfo requestSession = UTIL.resolveSessionInfo(
         sessionConfig.preset, sessionConfig.customSession, sessionConfig.customLabel, sessionConfig.timezone)
    if not na(requestSession)
        needsIntrabarData := UTIL.needsSessionIntrabars(requestSession)

// One conditional request, including historical initialization for realtime use.
UTIL.IntrabarData intrabarData = UTIL.requestIntrabarData(i_daysInput, needsIntrabarData)

// #endregion Shared Runtime Context

// #region Session Execution ******************************

bool  showHighBreak = false, bool showLowBreak = false
float sessionHigh   = na,    float sessionLow  = na
color sessionTint   = na

// The history-bearing engine call stays in unconditional scope. The library returns na
// immediately for disabled configurations, so a disabled slot remains inexpensive.
// No calendar-day cutoff: actual session records are retained in syncSessionVisuals().
UTIL.SessionInfo sessionInfo = UTIL.runSessionEngine(sessionConfig, sessionStates, intrabarData, TIMENOW, int(na))
if not na(sessionInfo)
    syncSessionVisuals(sessionConfig, visualConfig, sessionInfo, sessionStates, TIMENOW, daysLimit, SESSION_SLOT_KEY)
    string alertLabel = (sessionConfig.preset == UTIL.SessionPreset.Custom ? i_customLabel : sessionInfo.labelText)
    [highBreakFlag, lowBreakFlag] = processSessionBreakAlerts(
         sessionStates, i_alertMode, alertLabel, TIMENOW, isAlertWindowOpen, SESSION_SLOT_KEY)
    showHighBreak := highBreakFlag
    showLowBreak  := lowBreakFlag
    bool tintBar = not na(UTIL.getActiveSession(sessionStates, TIMENOW)) and visualConfig.showBackground and
      not sessionInfo.isDaily and isWithinHistory
    sessionTint := (tintBar ? visualConfig.backgroundColor : na)
    if array.size(sessionStates) > 0
        UTIL.SessionState newestSession = array.get(sessionStates, 0)
        sessionHigh := newestSession.highPrice
        sessionLow  := newestSession.lowPrice

// #endregion Session Execution

// #region Trade Window Execution *************************

if a_windowLines
    windowState := drawTradeWindow(windowStartLines, windowEndLines, windowState,
         i_window, i_windowHistory, i_windowColor, i_windowStyle.toLineStyle(),
         i_windowSize.toLineWidth(), daysLimit, TIMENOW)
else
    windowState := clearTradeWindow(windowStartLines, windowEndLines)

color tradeWindowTint = (a_windowBg and isTradeWindowActive and isWithinHistory ? i_windowBgColor : na)

// #endregion Trade Window Execution

// #region Cleanup ****************************************

if barstate.islast
    pruneBreakTrackers(sessionStates, SESSION_SLOT_KEY)

// #endregion Cleanup

// #region Global Plots ***********************************

bgcolor(sessionTint)
bgcolor(tradeWindowTint)

plot(sessionHigh, "Session High", color = i_primeColor, display = display.status_line)
plot(sessionLow,  "Session Low",  color = i_primeColor, display = display.status_line)

plotshape(showHighBreak, "Session High Break", shape.triangleup, location.abovebar, i_primeColor, size = size.small, display = display.all - display.status_line)
plotshape(showLowBreak,  "Session Low Break",  shape.triangledown, location.belowbar, i_primeColor, size = size.small, display = display.all - display.status_line)

// #endregion Global Plots

// #endregion Execution