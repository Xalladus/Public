// #region History ****************************************

// Worst case per retained day: four lines, two labels, and one box, which keeps 90 days of
// history inside TradingView's 500-ID limit for every object type.
const int MAX_HISTORY_DAYS = 90

var string iGroupHistory = "History"
i_showHistory = input.bool(true, "History.", group = iGroupHistory, inline = "H1", display = display.none)
i_daysInput   = input.int(5, "Previous sessions:", 1, MAX_HISTORY_DAYS, 1, tt_historyDays, group = iGroupHistory, inline = "H1", display = display.none)

