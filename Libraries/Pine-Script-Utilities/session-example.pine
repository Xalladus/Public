// #region History ****************************************

var string iGroupHistory = "History"
i_showHistory = input.bool(true, "History.", group = iGroupHistory, inline = "H1", display = display.none)
i_daysInput   = input.int(5, "Previous sessions:", 1, 90, 1,
     "Previous occurrences retained per session, in addition to the current occurrence. Gaps do not consume this count. Available chart data and drawing limits can reduce it. Daily identifiers count actual daily bars; trade-window history still uses calendar days.",
     group = iGroupHistory, inline = "H1", display = display.none)
i_debugHistory = input.bool(false, "Diagnose history in Pine Logs", group = iGroupHistory,
     tooltip = "Lists retained session dates, price availability, and box coordinates once after history loads.", display = display.none)

// #endregion History

// #region Session Day ************************************

var string iGroupSessDay = "Session Day"
i_sessionDay       = input.enum(UTIL.SessionPreset.DailyFxClose, "Session Timing",
     options = [UTIL.SessionPreset.DailyFxClose, UTIL.SessionPreset.DailyUtc,
         UTIL.SessionPreset.DailyExchange, UTIL.SessionPreset.DailyNewYork],
     group = iGroupSessDay, tooltip = tt_day, display = display.none)

