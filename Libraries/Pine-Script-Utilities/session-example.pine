var array<UTIL.SessionState> sessionStates01  = array.new<UTIL.SessionState>()
var array<UTIL.SessionState> sessionStates02  = array.new<UTIL.SessionState>()
var array<UTIL.SessionState> sessionStates03  = array.new<UTIL.SessionState>()
