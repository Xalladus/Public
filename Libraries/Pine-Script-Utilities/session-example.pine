//@version=6

//+-------------------------------------------------------+
//                       INFORMATION                      |
//+-------------------------------------------------------+
// #region Information

// U-Sessions plots up to four sessions plus a daily session with boxes, high/low lines, labels,
// vertical trade-window lines, daily dividers, and psychological level grids.
//
// Presets resolve in their native timezone. Custom sessions, trade windows, and line end times
// use the timezone selected by the user. When the first bar after a long weekend or holiday gap
// arrives, the utility library adjusts affected session and line lifecycle times from the gap
// actually present in the chart data.
//
// Session lifecycle state is owned by UtilityLibrary1CG. This script owns inputs, visuals,
// and alert policy.

// #endregion Information

indicator("New Ultra-Session Levels", shorttitle = "U-Sessions", precision = 5,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, overlay = true)

import OneCleverGuy/UtilityLibrary1CG/1 as UTIL
import OneCleverGuy/RoundNumberLibrary/3 as RNL

//+-------------------------------------------------------+
//                          INPUTS                        |
//+-------------------------------------------------------+
// #region Inputs

// #region Input Enums ************************************

enum AlertMode
    off      = "No Alerts"
    onBreak  = "On Break"
    closeOut = "Close Out"
    closeIn  = "Close In (Sweep)"

enum RoundGranularity
    whole   = "Whole"
    half    = "Half"
    quarter = "Quarter"
    fifth   = "Fifth"
    eighth  = "Eighth"
    tenth   = "Tenth"
    eighty  = "80/20"

// #endregion Input Enums

// #region Tooltips ***************************************

string tt_keepAhead    = "The number of bars the line stays in front of price, stopping at line end time."
string tt_nextDay      = "Time the line ends, in your selected timezone. Check the box to extend it another day."
string tt_colors       = "Major Color: session text, lines, and box outline.\nMinor Color: box fill and background."
string tt_highLow      = "Style of the high and low lines. Disabled for daily sessions."
string tt_box          = "Style of the session box. Disabled for daily sessions."
string tt_boxText      = "Display the session label inside the box."
string tt_history      = "Display previous sessions as styled above."
string tt_zero         = "Auto-detected round-number grid based on price magnitude and tick size."
string tt_vLines       = "Vertical lines marking the start and finish of the selected window, in your selected timezone."
string tt_custom       = "Custom times are in your selected timezone. Presets use their own market timezone."
                       + "\nIdentical open and close times create a 24-hour session."
string tt_day          = "FX Close runs 17:00 to 17:00 New York.\nUTC, Exchange, and New York daily sessions run midnight to midnight."
string tt_divider      = "Vertical line drawn at the start of each daily session."
string tt_dayLabels    = "Bubble for the day of the week.\nColor 1: background\nColor 2: text."
string tt_timezone     = "Applied to custom sessions, trade windows, and line end times."
string tt_alertSession = "Alerts fire after the session closes, when its high or low is taken."
                       + " With trade windows enabled, only breaks inside those windows alert."
                       + "\nOn Break: first touch of the level."
                       + "\nClose Out: candle closes beyond the level."
                       + "\nClose In (Sweep): candle pierces the level and closes back inside."

// #endregion Tooltips

// #region Timezone ***************************************

var string iGroupTimezone = "Timezone"
i_timeZone = input.enum(UTIL.Timezones.ny, "Select Time Zone", group = iGroupTimezone, tooltip = tt_timezone, display = display.none)

// #endregion Timezone

// #region Session 01 *************************************

var string iGroupSess01 = "SESSION 01"
i_showAll01       = input.bool(true, "", group = iGroupSess01, inline = "D6", display = display.none)
i_session01       = input.enum(UTIL.SessionPreset.Custom, "Session", group = iGroupSess01, inline = "D6", display = display.none, active = i_showAll01)
bool a_custom01   = i_showAll01 and i_session01 == UTIL.SessionPreset.Custom
i_customLabel01   = input.string("Asia", "Label", group = iGroupSess01, inline = "D6", active = a_custom01, display = display.none)
i_customSession01 = input.session("1600-0000", "Custom Session", group = iGroupSess01, tooltip = tt_custom, display = display.none, active = a_custom01)

i_primeColor01    = input.color(color.new(#4caf50, 0), "Major Color", group = iGroupSess01, inline = "D1", active = i_showAll01, display = display.none)
i_subColor01      = input.color(color.new(#4caf50, 90), "Minor Color", group = iGroupSess01, inline = "D1", active = i_showAll01, display = display.none)
i_sessionBg01     = input.bool(false, "Background", group = iGroupSess01, inline = "D1", tooltip = tt_colors, active = i_showAll01, display = display.none)

i_showBox01       = input.bool(true, "Session Box", group = iGroupSess01, inline = "D3", active = i_showAll01, display = display.none)
bool a_box01      = i_showAll01 and i_showBox01
i_boxStyle01      = input.enum(UTIL.LineStyle.dashed, "", group = iGroupSess01, inline = "D3", display = display.none, active = a_box01)
i_boxSize01       = input.enum(UTIL.LineSize.thin, "", group = iGroupSess01, inline = "D3", display = display.none, tooltip = tt_box, active = a_box01)
i_showBoxHist01   = input.bool(true, "History", group = iGroupSess01, inline = "D3", tooltip = tt_history, display = display.none, active = a_box01)

i_showBoxText01   = input.bool(false, "Box Text", group = iGroupSess01, inline = "D7", display = display.none, active = a_box01)
bool a_boxText01  = a_box01 and i_showBoxText01
i_boxTextColor01  = input.color(color.new(#FFFFFF, 0), " ", group = iGroupSess01, inline = "D7", display = display.none, active = a_boxText01)
i_boxTextSize01   = input.enum(UTIL.TextSize.tiny, "Size", group = iGroupSess01, inline = "D7", display = display.none, active = a_boxText01)
i_boxTextHAlign01 = input.enum(UTIL.HorizontalAlign.left, "H Align:", group = iGroupSess01, inline = "D7b", display = display.none, active = a_boxText01)
i_boxTextVAlign01 = input.enum(UTIL.VerticalAlign.top, "V Align:", group = iGroupSess01, inline = "D7b", display = display.none, tooltip = tt_boxText, active = a_boxText01)

i_showHiLo01      = input.bool(true, "Highs/Lows", group = iGroupSess01, inline = "D2", active = i_showAll01, display = display.none)
bool a_hiLo01     = i_showAll01 and i_showHiLo01
i_hiLoStyle01     = input.enum(UTIL.LineStyle.dotted, "", group = iGroupSess01, inline = "D2", display = display.none, active = a_hiLo01)
i_hiLoSize01      = input.enum(UTIL.LineSize.thin, "", group = iGroupSess01, inline = "D2", display = display.none, active = a_hiLo01)
i_showLineHist01  = input.bool(true, "History", group = iGroupSess01, inline = "D2", tooltip = tt_history, display = display.none, active = a_hiLo01)

i_lineAnchor01    = input.enum(UTIL.SessionAnchor.SessionEnd, "Line Starts:", group = iGroupSess01, inline = "D4", display = display.none, active = a_hiLo01)
i_aheadTime01     = input.int(10, "Frontrun", minval = 1, maxval = 50, group = iGroupSess01, inline = "D4", tooltip = tt_keepAhead, display = display.none, active = a_hiLo01)
i_lineEndHour01   = input.enum(UTIL.Hours.h17, "Line Ends", group = iGroupSess01, inline = "D5", display = display.none, active = a_hiLo01)
i_lineEndMinute01 = input.enum(UTIL.Minutes.m0, ":", group = iGroupSess01, inline = "D5", display = display.none, active = a_hiLo01)
i_lineExtraDay01  = input.bool(false, "+1 Day", tt_nextDay, inline = "D5", group = iGroupSess01, display = display.none, active = a_hiLo01)
i_showLabel01     = input.bool(true, "Line Labels", group = iGroupSess01, inline = "D9", tooltip = tt_highLow, active = a_hiLo01, display = display.none)

i_alertMode01     = input.enum(AlertMode.off, "Alert Mode", group = iGroupSess01, inline = "D8", tooltip = tt_alertSession, active = i_showAll01, display = display.none)

// #endregion Session 01

