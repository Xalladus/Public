var UTIL.SessionConfig sessionConfig01 = UTIL.SessionConfig.new(
     isEnabled = i_showAll01,                     preset = i_session01,
     customLabel = i_customLabel01,               customSession = i_customSession01,
     timezone = USER_TIMEZONE,                    anchor = i_lineAnchor01,
     lineEndHour = i_lineEndHour01.toHourInt(),   lineEndMinute = i_lineEndMinute01.toMinuteInt(),
     lineEndTimezone = USER_TIMEZONE,             addExtraLineDay = i_lineExtraDay01)
var UTIL.SessionConfig sessionConfig02 = UTIL.SessionConfig.new(
     isEnabled = i_showAll02,                     preset = i_session02,
     customLabel = i_customLabel02,               customSession = i_customSession02,
     timezone = USER_TIMEZONE,                    anchor = i_lineAnchor02,
     lineEndHour = i_lineEndHour02.toHourInt(),   lineEndMinute = i_lineEndMinute02.toMinuteInt(),
     lineEndTimezone = USER_TIMEZONE,             addExtraLineDay = i_lineExtraDay02)
var UTIL.SessionConfig sessionConfig03 = UTIL.SessionConfig.new(
     isEnabled = i_showAll03,                     preset = i_session03,
     customLabel = i_customLabel03,               customSession = i_customSession03,
     timezone = USER_TIMEZONE,                    anchor = i_lineAnchor03,
     lineEndHour = i_lineEndHour03.toHourInt(),   lineEndMinute = i_lineEndMinute03.toMinuteInt(),
     lineEndTimezone = USER_TIMEZONE,             addExtraLineDay = i_lineExtraDay03)
var UTIL.SessionConfig sessionConfig04 = UTIL.SessionConfig.new(
     isEnabled = i_showAll04,                     preset = i_session04,
     customLabel = i_customLabel04,               customSession = i_customSession04,
     timezone = USER_TIMEZONE,                    anchor = i_lineAnchor04,
     lineEndHour = i_lineEndHour04.toHourInt(),   lineEndMinute = i_lineEndMinute04.toMinuteInt(),
     lineEndTimezone = USER_TIMEZONE,             addExtraLineDay = i_lineExtraDay04)
var UTIL.SessionConfig sessionConfigDay = UTIL.SessionConfig.new(
     isEnabled = i_showHiLoDay,                   preset = i_sessionDay,
     anchor = i_lineAnchorDay,
     lineEndHour = i_lineEndHourDay.toHourInt(),  lineEndMinute = i_lineEndMinuteDay.toMinuteInt(),
     lineEndTimezone = USER_TIMEZONE,             addExtraLineDay = true)

var SessionVisualConfig visualConfig01 = SessionVisualConfig.new(
     i_showAll01,                    i_primeColor01,                   i_subColor01,
     i_sessionBg01,                  i_showHiLo01,                     i_hiLoStyle01.toLineStyle(),
     i_hiLoSize01.toLineWidth(),     i_showLabel01,                    i_showBox01,
     i_boxStyle01.toLineStyle(),     i_boxSize01.toLineWidth(),        i_aheadTime01,
     i_showHistory and i_showLineHist01, i_showHistory and i_showBoxHist01, i_showBoxText01,
     i_boxTextColor01,               i_boxTextSize01.toTextSizeString(),
     i_boxTextHAlign01.toHorizontalAlign(),                            i_boxTextVAlign01.toVerticalAlign(),
     i_lineAnchor01)
var SessionVisualConfig visualConfig02 = SessionVisualConfig.new(
     i_showAll02,                    i_primeColor02,                   i_subColor02,
     i_sessionBg02,                  i_showHiLo02,                     i_hiLoStyle02.toLineStyle(),
     i_hiLoSize02.toLineWidth(),     i_showLabel02,                    i_showBox02,
     i_boxStyle02.toLineStyle(),     i_boxSize02.toLineWidth(),        i_aheadTime02,
     i_showHistory and i_showLineHist02, i_showHistory and i_showBoxHist02, i_showBoxText02,
     i_boxTextColor02,               i_boxTextSize02.toTextSizeString(),
     i_boxTextHAlign02.toHorizontalAlign(),                            i_boxTextVAlign02.toVerticalAlign(),
     i_lineAnchor02)
var SessionVisualConfig visualConfig03 = SessionVisualConfig.new(
     i_showAll03,                    i_primeColor03,                   i_subColor03,
     i_sessionBg03,                  i_showHiLo03,                     i_hiLoStyle03.toLineStyle(),
     i_hiLoSize03.toLineWidth(),     i_showLabel03,                    i_showBox03,
     i_boxStyle03.toLineStyle(),     i_boxSize03.toLineWidth(),        i_aheadTime03,
     i_showHistory and i_showLineHist03, i_showHistory and i_showBoxHist03, i_showBoxText03,
     i_boxTextColor03,               i_boxTextSize03.toTextSizeString(),
     i_boxTextHAlign03.toHorizontalAlign(),                            i_boxTextVAlign03.toVerticalAlign(),
     i_lineAnchor03)
var SessionVisualConfig visualConfig04 = SessionVisualConfig.new(
     i_showAll04,                    i_primeColor04,                   i_subColor04,
     i_sessionBg04,                  i_showHiLo04,                     i_hiLoStyle04.toLineStyle(),
     i_hiLoSize04.toLineWidth(),     i_showLabel04,                    i_showBox04,
     i_boxStyle04.toLineStyle(),     i_boxSize04.toLineWidth(),        i_aheadTime04,
     i_showHistory and i_showLineHist04, i_showHistory and i_showBoxHist04, i_showBoxText04,
