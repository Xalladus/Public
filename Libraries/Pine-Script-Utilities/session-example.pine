// #region UDT's

// #region Helper UDTs ************************************

type BarTracker
    int sessBar = na
    int hiBar   = na
    int loBar   = na
    int hiTime  = na
    int loTime  = na
    int endBar  = na

type BreakTracker
    int  sessStartTime = na
    bool highBroken    = false
    bool lowBroken     = false
    bool highAlerted   = false
    bool lowAlerted    = false

// Styling is stored as resolved Pine constants so the render path never converts enums per bar.
type SessionVisualConfig
    bool   isEnabled       = false
    color  primeColor      = na
    color  backgroundColor = na
    bool   showBackground  = false
    bool   showHiLo        = false
    string lineStyle       = line.style_dotted
    int    lineWidth       = 1
    bool   showLabel       = false
    bool   showBox         = false
    string boxStyle        = line.style_dashed
    int    boxWidth        = 1
    int    aheadBars       = 10
    bool   showLineHistory = false
    bool   showBoxHistory  = false
    bool   showBoxText     = false
    color  boxTextColor    = #FFFFFF
    string boxTextSize     = size.tiny
    string boxTextHAlign   = text.align_left
    string boxTextVAlign   = text.align_top
    UTIL.SessionAnchor anchor = UTIL.SessionAnchor.SessionEnd

type SessionVisualState
    line  highLine  = na
    label highLabel = na
    line  lowLine   = na
    label lowLabel  = na
    box   square    = na

type RoundLevelConfig
    bool   isEnabled = false
    int    count     = 1
    color  lineColor = na
    string lineStyle = line.style_solid
    int    lineWidth = 1

type SessionExecMeta
    string    mapKey    = na
    bool      isEnabled = false
    AlertMode alertMode = AlertMode.off
    string    labelText = na

type TradeWindowState
    int  lastDrawnStart = na
    bool endAdjusted    = false

// #endregion Helper UDTs

// #endregion UDT's

//+-------------------------------------------------------+
//                     GLOBAL VARIABLES                   |
//+-------------------------------------------------------+
// #region Global Variables

// #region Helper Globals *********************************

// #region Runtime Context //

var string USER_TIMEZONE = i_timeZone.toTimezone()

// Realtime calculations use the current clock. Historical bars and replay use the bar close,
// which prevents the machine clock from making old bars appear to be far in the future.
bool isReplayLikeRealtime = barstate.isrealtime and not na(time_close) and timenow > time_close + UTIL.durationMs(UTIL.Duration.Day)
int  TIMENOW = (barstate.isrealtime and not isReplayLikeRealtime ? timenow : nz(time_close, time))

// Retention is resolved once from a shared budget so independently configured features cannot
// collectively exceed TradingView's 500-ID limits. A small reserve absorbs transient rollover objects.
const int MANAGED_DRAWING_BUDGET = 480
int requestedHistoryDays = (i_showHistory ? i_daysInput : 0)

int liveSessionLineSlots = (
     (i_showAll01 and i_showHiLo01 ? 1 : 0) + (i_showAll02 and i_showHiLo02 ? 1 : 0)
     + (i_showAll03 and i_showHiLo03 ? 1 : 0) + (i_showAll04 and i_showHiLo04 ? 1 : 0)
     + (i_showHiLoDay ? 1 : 0))
int historySessionLineSlots = (
     (i_showAll01 and i_showHiLo01 and i_showLineHist01 ? 1 : 0)
     + (i_showAll02 and i_showHiLo02 and i_showLineHist02 ? 1 : 0)
     + (i_showAll03 and i_showHiLo03 and i_showLineHist03 ? 1 : 0)
     + (i_showAll04 and i_showHiLo04 and i_showLineHist04 ? 1 : 0)
     + (i_showHiLoDay ? 1 : 0))
int liveLabelSlots = (
     (i_showAll01 and i_showHiLo01 and i_showLabel01 ? 1 : 0)
     + (i_showAll02 and i_showHiLo02 and i_showLabel02 ? 1 : 0)
     + (i_showAll03 and i_showHiLo03 and i_showLabel03 ? 1 : 0)
     + (i_showAll04 and i_showHiLo04 and i_showLabel04 ? 1 : 0)
     + (i_showHiLoDay and i_showLabelDay ? 1 : 0))
int historyLabelSlots = (
     (i_showAll01 and i_showHiLo01 and i_showLabel01 and i_showLineHist01 ? 1 : 0)
     + (i_showAll02 and i_showHiLo02 and i_showLabel02 and i_showLineHist02 ? 1 : 0)
     + (i_showAll03 and i_showHiLo03 and i_showLabel03 and i_showLineHist03 ? 1 : 0)
     + (i_showAll04 and i_showHiLo04 and i_showLabel04 and i_showLineHist04 ? 1 : 0)
     + (i_showHiLoDay and i_showLabelDay ? 1 : 0))
int liveBoxSlots = (
     (i_showAll01 and i_showBox01 ? 1 : 0) + (i_showAll02 and i_showBox02 ? 1 : 0)
     + (i_showAll03 and i_showBox03 ? 1 : 0) + (i_showAll04 and i_showBox04 ? 1 : 0))
int historyBoxSlots = (
     (i_showAll01 and i_showBox01 and i_showBoxHist01 ? 1 : 0)
     + (i_showAll02 and i_showBox02 and i_showBoxHist02 ? 1 : 0)
     + (i_showAll03 and i_showBox03 and i_showBoxHist03 ? 1 : 0)
     + (i_showAll04 and i_showBox04 and i_showBoxHist04 ? 1 : 0))
int liveWindowSlots = (i_showWindow01 ? 1 : 0) + (i_showWindow02 ? 1 : 0)
int historyWindowSlots = (
     (i_showWindow01 and i_windowHist01 ? 1 : 0) + (i_showWindow02 and i_windowHist02 ? 1 : 0))
int roundLineReserve = (
     (i_showRoundMajor ? i_roundCountMajor * 2 + 1 : 0)
     + (i_showRoundMinor ? i_roundCountMinor * 2 + 1 : 0))
int dividerSlot = (i_showDivide ? 1 : 0)

int lineBaseCost   = liveSessionLineSlots * 2 + liveWindowSlots * 2 + roundLineReserve + dividerSlot
int linePerDayCost = historySessionLineSlots * 2 + historyWindowSlots * 2 + dividerSlot
int labelBaseCost  = liveLabelSlots * 2
int labelPerDayCost = historyLabelSlots * 2
int boxBaseCost    = liveBoxSlots
int boxPerDayCost  = historyBoxSlots

int lineBudgetDays = (linePerDayCost > 0
     ? math.max(int(math.floor((MANAGED_DRAWING_BUDGET - lineBaseCost) / float(linePerDayCost))), 0)
     : requestedHistoryDays)
int labelBudgetDays = (labelPerDayCost > 0
     ? math.max(int(math.floor((MANAGED_DRAWING_BUDGET - labelBaseCost) / float(labelPerDayCost))), 0)
     : requestedHistoryDays)
int boxBudgetDays = (boxPerDayCost > 0
     ? math.max(int(math.floor((MANAGED_DRAWING_BUDGET - boxBaseCost) / float(boxPerDayCost))), 0)
     : requestedHistoryDays)
int daysLimit = math.min(requestedHistoryDays,
     math.min(lineBudgetDays, math.min(labelBudgetDays, boxBudgetDays)))
bool historyWasCapped = daysLimit < requestedHistoryDays
var bool historyCapNoticeSent = false

// Day labels sit thirteen hours into the daily session so they land mid-morning on either daily mode.
int DAY_LABEL_OFFSET_MS = UTIL.durationMs(UTIL.Duration.Hour) * 13

bool isWithinHistory = UTIL.isWithinHistoryWindow(daysLimit, last_bar_time)

// Daily identifiers count observed trading days, not elapsed calendar days.
// This display-only mask uses daily bar indexes; no prices or future OHLC are requested.
// lookahead_on applies the day's visibility from its opening candle, preserving top-of-chart plotshapes.
bool isWithinIdentifierHistory = request.security(syminfo.tickerid, "1D",
     last_bar_index - bar_index <= daysLimit, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// #endregion Runtime Context

