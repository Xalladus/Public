i_showLabelDay     = input.bool(false, "Line Labels", group = iGroupSessDay, inline = "E1", display = display.none, active = i_showHiLoDay)
i_primeColorDay    = input.color(color.new(#b2b5be, 0), "Major Color", group = iGroupSessDay, inline = "E2", active = i_showHiLoDay, display = display.none)
i_hiLoStyleDay     = input.enum(UTIL.LineStyle.dotted, "", group = iGroupSessDay, inline = "E2", display = display.none, active = i_showHiLoDay)
