i_aheadTimeDay     = input.int(10, "Frontrun", minval = 1, maxval = 50, group = iGroupSessDay, inline = "E3", tooltip = tt_keepAhead, display = display.none, active = i_showHiLoDay)
i_lineEndHourDay   = input.enum(UTIL.Hours.h17, "Line Ends", group = iGroupSessDay, inline = "E4", display = display.none, active = i_showHiLoDay)
i_lineEndMinuteDay = input.enum(UTIL.Minutes.m0, ":", group = iGroupSessDay, inline = "E4", display = display.none, active = i_showHiLoDay)
